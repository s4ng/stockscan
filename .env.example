# cp .env.example .env 후 값을 채운다. .env는 절대 커밋하지 않는다.
#
# 여기에는 **부트스트랩·인프라 설정만** 둔다.
# 증권사·거래소·LLM·알림 채널의 API 키는 이 파일에 넣지 않는다.
# 그것들은 앱 실행 후 UI(연결 / 알림 채널)에서 등록하며, 마스터 키로 암호화되어
# DB에 저장된다. 같은 소스를 여러 개 등록하고 재시작 없이 교체해야 하기 때문이다.

# 자격 증명 암호화 마스터 키. 이 키만은 DB에 넣을 수 없다(자기 자신을 복호화해야 하므로).
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 이 키를 잃으면 저장된 API 키를 복호화할 수 없다 — SQLite 파일과 함께 백업할 것.
TRADEFLOW_MASTER_KEY=

# 디버그 로그 (SQL 에코 포함)
TRADEFLOW_DEBUG=false

# 실주문 전역 차단 스위치. Phase 5 전까지는 반드시 false.
TRADEFLOW_LIVE_TRADING_ENABLED=false

# 저장소. 기본값은 ./data/tradeflow.db
# TRADEFLOW_DATABASE_URL=sqlite+aiosqlite:///./data/tradeflow.db
