# cp .env.example .env 후 값을 채운다. .env는 절대 커밋하지 않는다.
#
# 여기에는 **부트스트랩·인프라 설정만** 둔다.
# 알림 채널(텔레그램)과 LLM의 자격 증명은 이 파일이 아니라 앱에 등록하며,
# 마스터 키로 암호화되어 DB에 저장된다. 같은 소스를 여러 개 등록하고
# 재시작 없이 교체해야 하기 때문이다.
#
# 시세에는 자격 증명이 필요 없다 — 일봉 고정으로 무인증 소스만 쓴다
# (PyKRX · yfinance · FDR · CCXT 공개 OHLCV). ARCHITECTURE.md 3.3 참조.

# 자격 증명 암호화 마스터 키. 이 키만은 DB에 넣을 수 없다(자기 자신을 복호화해야 하므로).
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 이 키를 잃으면 저장된 API 키를 복호화할 수 없다 — SQLite 파일과 함께 백업할 것.
STOCKSCAN_MASTER_KEY=

# 디버그 로그 (SQL 에코 포함)
STOCKSCAN_DEBUG=false

# 실주문 전역 차단 스위치. Phase 5 전까지는 반드시 false.
STOCKSCAN_LIVE_TRADING_ENABLED=false

# 저장소. 상대 경로는 설정 디렉터리 기준 — 기본값은 ~/.stockscan/data/stockscan.db
# ⚠️ --commit 실행에서만 만들어진다. 읽기 전용 명령은 파일을 건드리지 않는다.
# ⚠️ ohlcv_cache가 여기 산다. 무료 소스가 막혀도 남는 유일한 자산이라 백업 대상이다(§3.9).
# STOCKSCAN_DATABASE_URL=sqlite+aiosqlite:///./data/stockscan.db

# 설정·전략·DB·리포트가 사는 디렉터리. 기본값은 ~/.stockscan
# 저장소 바깥이라 코드를 지우고 다시 받아도 내 전략과 캐시가 남는다. 저장소의 sample/은
# 예제일 뿐이므로, 처음 쓸 때 통째로 복사한다: cp sample/* ~/.stockscan/
# 아래 경로 설정들은 모두 이 디렉터리 기준의 상대 경로다.
# STOCKSCAN_CONFIG_DIR=~/.stockscan

# 실행할 파이프라인 정의. 상대 경로는 위 설정 디렉터리 기준이다.
# 형식은 YAML로 확정 (ARCHITECTURE.md 11장 4번). 로더가 확장자로 갈라 받으므로
# 기존 .json 파일도 그대로 읽힌다.
# 기본은 추세추종(config.yml). 12-1 횡단면 모멘텀은 demo.yaml이고 -p로 부른다.
# STOCKSCAN_CONFIG_PATH=config.yml

# 사용자 전략 파일의 위치. 비워 두면 **실행 중인 파이프라인 파일과 같은 디렉터리**에서
# 찾는다 — 설정과 전략은 한 벌이라 함께 옮겨야 하기 때문이다(-p sample/demo.yaml이
# sample/의 전략을 집는 것도 이 규칙이다). 값을 주면 그쪽이 이긴다.
# STOCKSCAN_STRATEGIES_DIR=

# 리포트 산출물(정적 HTML). 기본값은 ~/.stockscan/reports
# STOCKSCAN_REPORTS_DIR=reports

# 표시용 타임존은 파이프라인 정의의 settings.user_timezone에 있다 (파이프라인마다 다를 수 있으므로).
# 저장은 항상 UTC다 — CLAUDE.md 규칙 5.

# 텔레그램 알림. 둘 다 채워야 채널이 열린다 — 하나라도 비면 serve는 기록만 한다.
# ⚠️ 파이프라인 정의에는 절대 넣지 않는다 (규칙 7). 설정 파일은 복사·공유되기 때문이다.
# 봇 생성: @BotFather → /newbot · chat_id 확인: 봇에게 아무 말이나 보낸 뒤
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# STOCKSCAN_TELEGRAM_TOKEN=
# STOCKSCAN_TELEGRAM_CHAT_ID=
