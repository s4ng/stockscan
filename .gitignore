# --- 비밀 정보 (절대 커밋 금지) ---
.env
.env.local
*.key
*.pem

# --- 데이터 ---
# 정본은 ~/.marketscan/data/ 다 (저장소 바깥이라 여기 걸릴 일이 없다).
# 아래는 MARKETSCAN_CONFIG_DIR을 저장소 안으로 돌렸을 때를 위한 안전망이다.
data/
*.db
*.db-wal
*.db-shm

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# --- 산출물 ---
# 정본은 ~/.marketscan/reports/ 다. 아래는 위와 같은 안전망.
reports/

# --- 에디터 / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# 작업 중인 문서 사본 (README copy.md 등)
*copy.md
